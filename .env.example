# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.
# These are read server-side only (api/ and vite.config.js). None of them are
# VITE_-prefixed, so none can reach the browser bundle. Keep it that way.
#
# The same four variables must also be set in:
#   Vercel -> Project -> Settings -> Environment Variables

# From https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Sender. Resend requires a verified domain to send to arbitrary recipients.
# Until milansunuwar.com is verified, use the test sender below — it can ONLY
# deliver to the email address on your own Resend account.
#   Test:  onboarding@resend.dev
#   Live:  Milan Sunuwar <website@milansunuwar.com>
CONTACT_FROM=onboarding@resend.dev

# Where enquiries land.
#   Test:  the email address your Resend account is registered with
#   Live:  hello@milansunuwar.com
CONTACT_TO=your-resend-account@example.com

# Send the visitor a confirmation email as well as notifying you.
# Must stay `false` while CONTACT_FROM is the test sender, which cannot deliver
# to visitors. Flip to `true` once the domain is verified.
CONTACT_AUTOREPLY=false
